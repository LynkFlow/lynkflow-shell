# Copy this file to .env and adjust per developer machine / environment.
# .env is gitignored; .env.example is the committed template every clone
# starts from. webpack.config.mjs reads these via `dotenv`.

# This app's own dev-server port. The Shell is served at the root ("/"), so
# pick a port that doesn't collide with any MFE's own PORT (each MFE's
# .env.example documents its own -- lynkflow-mfe-template/scratch-test-ui
# default to 3001).
PORT=3000

# --- Smoke-test remote only -- see README.md "Federation smoke test" ---
# There is no real domain MFE yet (.claude/rules/progress.md is between
# steps 9 and 11; lynkflow-users-ui is step 12, not started). This points
# at scratch-test-ui's dev server instead, purely to prove the Shell can
# actually federate against a running remote end to end. Delete this
# variable and the "scratch" entry in webpack.config.mjs's `remotes` the
# day a real domain MFE (e.g. lynkflow-users-ui) is ready to be wired in --
# don't leave the smoke-test remote sitting alongside real ones.
SCRATCH_REMOTE_URL=http://localhost:3001/remoteEntry.js

# --- Auth API (GEN-US001-009) ---
# Base URL of the auth backend the Shell's own login/signup/forgot-password/
# reset-password/activate-account screens call. No real lynkflow-users-svc
# (or an auth-specific service) exists yet (.claude/rules/progress.md) --
# this is scaffolding against the contract the reference implementation
# assumed, not a live integration. See src/api/authClient.ts.
AUTH_API_BASE_URL=/api/auth
